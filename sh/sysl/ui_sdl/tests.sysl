module sh.sysl.ui_sdl
@tests

import sh.sysl.ui.{Canvas, Cursor, Key, Modifiers, PointerButton, PointerReader, Press, Rect, no_modifiers,
                   recorder, render, signal, text, writes}
import sh.sysl.sdl3.{EventKind, MouseButton, SystemCursor, KMOD_SHIFT, KMOD_CTRL, KMOD_ALT, KMOD_GUI, KMOD_LSHIFT, KMOD_RCTRL,
                     KMOD_CAPS, KMOD_NUM, SCANCODE_BACKSPACE, SCANCODE_LEFT,
                     SCANCODE_RIGHT, SCANCODE_HOME, SCANCODE_RETURN, SCANCODE_A, SCANCODE_ESCAPE,
                     SCANCODE_END, SCANCODE_DELETE, SCANCODE_DOWN, SCANCODE_TAB, SCANCODE_INSERT,
                     SCANCODE_PAGEUP, SCANCODE_PAGEDOWN, SCANCODE_F1, SCANCODE_F2, SCANCODE_F12}
#if android
import sh.sysl.skitter.{Insets, insets, set_system_bars}
#endif
import sysl.fs.is_file

// What can be tested without a window, which is exactly the part that can be wrong without crashing.
//
// **The loop itself is proved by the two applications that use it** — `syslui-demo` on a desktop and
// `syslui-android` on a phone — because a frame loop needs a display server, a font and a
// compositor, and a test that mocked all three would be asserting the mock. What is here instead is
// the arithmetic and the mapping: a wrong scale is a whole interface at the wrong size, and a wrong
// key is a field that will not take a backspace.

// ## The keyboard

@test
private the_editing_keys_are_mapped()
    assert(key_of(SCANCODE_BACKSPACE) == Some(Key.Backspace))
    assert(key_of(SCANCODE_LEFT) == Some(Key.Left))
    assert(key_of(SCANCODE_HOME) == Some(Key.Home))
    assert(key_of(SCANCODE_END) == Some(Key.End))
    assert(key_of(SCANCODE_DELETE) == Some(Key.Delete))
    assert(key_of(SCANCODE_RETURN) == Some(Key.Enter))
end the_editing_keys_are_mapped

// **The keys an application moves by are mapped too**: the page keys, Insert, Escape and the function
// row -- a grid's PageDown and a field's `on_escape` reach a view through `keys()` like any other.
@test
private the_page_keys_escape_and_the_function_row_are_mapped()
    assert(key_of(SCANCODE_PAGEUP) == Some(Key.PageUp))
    assert(key_of(SCANCODE_PAGEDOWN) == Some(Key.PageDown))
    assert(key_of(SCANCODE_INSERT) == Some(Key.Insert))
    assert(key_of(SCANCODE_ESCAPE) == Some(Key.Escape))
    assert(key_of(SCANCODE_TAB) == Some(Key.Tab))
    assert(key_of(SCANCODE_F1) == Some(Key.F(1)))
    assert(key_of(SCANCODE_F2) == Some(Key.F(2)))
    assert(key_of(SCANCODE_F12) == Some(Key.F(12)))

    // Every key of the run is its own number, and the ends of the run are where it stops.
    for i in 0..<12
        assert(key_of(SCANCODE_F1 + i) == Some(Key.F(int(i) + 1)), s"F${i + 1}")

    assert(key_of(SCANCODE_F1 - 1) != Some(Key.F(0)), "the key before F1 is not a function key")
    assert(key_of(SCANCODE_F12 + 1).is_none(), "nor is the key after F12, which is Print Screen")
end the_page_keys_escape_and_the_function_row_are_mapped

// **A letter is not an editing key and must not be mapped.** Typed text arrives as a `TextInput`,
// already composed by the platform, and a driver that also mapped the letter would type everything
// twice on a desktop and produce the wrong character everywhere an input method is involved.
@test
private a_letter_is_not_mapped()
    assert(key_of(SCANCODE_A).is_none(), "typed text is a TextInput, not a key")
    assert(press_of(SCANCODE_A, KMOD_GUI).is_none(), "and ⌘A is the application's shortcut, by on_event")
end a_letter_is_not_mapped

// **Each modifier is the key it names**: alt is no longer folded into control, and command arrives.
// The word motion they used to stand for is the toolkit's `by_word`, which still answers for both.
@test
private a_press_carries_its_modifiers()
    assert(press_of(SCANCODE_LEFT, KMOD_SHIFT) == Some(Press(Key.Left, true, false, false, false)))
    assert(press_of(SCANCODE_RIGHT, KMOD_CTRL) == Some(Press(Key.Right, false, true, false, false)))
    assert(press_of(SCANCODE_RIGHT, KMOD_ALT) == Some(Press(Key.Right, false, false, true, false)),
           "alt is alt, not control")
    assert(press_of(SCANCODE_RIGHT, KMOD_GUI) == Some(Press(Key.Right, false, false, false, true)),
           "command arrives")
    assert(press_of(SCANCODE_LEFT, KMOD_LSHIFT | KMOD_RCTRL) == Some(Press(Key.Left, true, true, false, false)),
           "either side of the keyboard")
    assert(press_of(SCANCODE_DOWN, KMOD_SHIFT | KMOD_CTRL | KMOD_ALT | KMOD_GUI) ==
           Some(Press(Key.Down, true, true, true, true)), "all four at once")
    assert(press_of(SCANCODE_PAGEDOWN, KMOD_CAPS | KMOD_NUM) == Some(Press(Key.PageDown, false, false, false, false)),
           "a lock key is not a modifier")
    assert(press_of(SCANCODE_A, KMOD_SHIFT).is_none(), "and an unmapped key stays unmapped")
end a_press_carries_its_modifiers

// **An editor's arrows are what they were before alt was told apart from control**: both still move by
// word, and command and shift alone do not.
@test
private the_word_motion_survives_the_split()
    assert(press_of(SCANCODE_LEFT, KMOD_CTRL).unwrap().by_word, "control")
    assert(press_of(SCANCODE_LEFT, KMOD_ALT).unwrap().by_word, "a Mac moves by word with alt")
    assert(!press_of(SCANCODE_LEFT, KMOD_GUI).unwrap().by_word, "the command key is left for shortcuts")
    assert(!press_of(SCANCODE_LEFT, KMOD_SHIFT).unwrap().by_word)

#if macos
    assert(press_of(SCANCODE_F1, KMOD_GUI).unwrap().command, "a Mac's shortcut key is command")
    assert(!press_of(SCANCODE_F1, KMOD_CTRL).unwrap().command)
#else
    assert(press_of(SCANCODE_F1, KMOD_CTRL).unwrap().command, "elsewhere it is control")
    assert(!press_of(SCANCODE_F1, KMOD_GUI).unwrap().command)
#endif
end the_word_motion_survives_the_split

// ## The arithmetic between a window and an interface

@test
private a_scale_is_never_less_than_one()
    assert(scale_of(2.75) == 2.75, "a phone")
    assert(scale_of(1.0) == 1.0, "an ordinary display")

    // A zero reaching a layout would multiply every size in it to nothing -- a whole interface drawn
    // correctly at no size at all, which is far worse than an unscaled one.
    assert(scale_of(0.0) == 1.0, "and a display that will not say is one")
    assert(scale_of(-3.0) == 1.0)
end a_scale_is_never_less_than_one

// **The pointer's units are measured rather than assumed**, because which convention a platform uses
// is the thing nothing documents the same way twice.
@test
private a_pointer_lands_in_points()
    // A phone: the window is already pixels, so the ratio is one and only the scale divides.
    assert(point_scale(1080, 1080, 2.75) == 1.0 / 2.75, "a window reported in pixels")

    // A retina laptop: the window is in points at half the pixels, and the scale is two.
    assert(point_scale(900, 1800, 2.0) == 1.0, "a window reported in points on a 2x display")

    // An ordinary display: nothing moves at all.
    assert(point_scale(900, 900, 1.0) == 1.0)

    // A window that has not been made yet answers zero, and dividing by it would end the frame.
    assert(point_scale(0, 0, 2.0) == 0.5, "a size that is not known yet is still safe")
end a_pointer_lands_in_points

// Before the first mouse event nothing is being pointed at, not even what sits in the window's corner.
@test
private a_pointer_not_yet_seen_is_over_nothing()
    var c = recorder()
    val corner = Rect(0, 0, 40, 16)

    c.point(NO_POINTER, NO_POINTER, false)
    assert(!c.hovered(corner), "the corner is not lit by a pointer nobody has moved")

    c.point(0, 0, false)
    assert(c.hovered(corner), "and a real pointer at the origin does light it")
end a_pointer_not_yet_seen_is_over_nothing

// The interface is the window in points, less the system bars — and the bars are in pixels.
@test
private the_frame_is_the_window_less_the_bars()
    assert(frame_rect(1080, 2400, 2.75, 0, 0, 0, 0) == Rect(0, 0, 392, 872), "a phone, bars aside")
    assert(frame_rect(1080, 2400, 2.75, 0, 110, 0, 66) == Rect(0, 40, 392, 808), "with them")
    assert(frame_rect(900, 660, 1.0, 0, 0, 0, 0) == Rect(0, 0, 900, 660), "a desktop is the window")
end the_frame_is_the_window_less_the_bars

// **Bars wider than the window leave nothing rather than a negative rectangle**, which is what a
// phone reports for one frame while it is being turned.
@test
private bars_bigger_than_the_window_leave_nothing()
    val r = frame_rect(100, 100, 1.0, 80, 80, 80, 80)

    assert(r.w == 0 && r.h == 0, s"${r.w}x${r.h}")
end bars_bigger_than_the_window_leave_nothing

// **Where the bars come FROM, which is the whole of what 0.2.0 changed.** Until this version an
// application pushed them in through a `set_insets` this module owned, and the JNI export that
// called it had to be written by hand in every application because the symbol is mangled from the
// application's own package. Skitter fixes the activity's class, so the bridge is a library's — and
// this test drives that bridge and asserts the frame the loop would lay out against.
//
// **It is a composition test and it could not have been written before**, because there was no path
// from Skitter's storage to this module at all. What it would catch is the wiring being dropped or
// the four edges being read in the wrong order, either of which draws a plausible interface slightly
// wrong on every phone and nothing else notices.
//
// Skitter is an Android-only dependency, so this test exists only in an Android build.
#if android
@test
private the_bars_arrive_from_skitters_bridge()
    // Six arguments because JNI hands a native method the environment and the instance first, and
    // this drives the exported function exactly as Android would.
    set_system_bars(null, null, 0, 110, 0, 66)

    val ins = insets()

    assert_eq(ins, Insets(0, 110, 0, 66), "the bridge's four edges, in order")

    // The same rectangle the test above pins with the numbers written out, reached through the
    // bridge instead — so a wiring that dropped an edge or swapped two fails here and nowhere else.
    assert(frame_rect(1080, 2400, 2.75, ins.left, ins.top, ins.right, ins.bottom) ==
           Rect(0, 40, 392, 808), "the phone's own numbers, through the bridge")

    // A rotation replaces them rather than accumulating, and the next frame is laid out against the
    // new ones with nothing having had to notice the phone turned.
    set_system_bars(null, null, 80, 0, 40, 0)

    val turned = insets()

    assert_eq(turned, Insets(80, 0, 40, 0), "and the second report replaces the first")
    assert(frame_rect(2400, 1080, 2.75, turned.left, turned.top, turned.right, turned.bottom) ==
           frame_rect(2400, 1080, 2.75, 80, 0, 40, 0), "on the very next frame")

    // Left as it was found: this is module storage shared with every other test in the run.
    set_system_bars(null, null, 0, 0, 0, 0)

    assert_eq(insets(), Insets(0, 0, 0, 0))
end the_bars_arrive_from_skitters_bridge
#endif

// On a desktop there are no system bars, and the driver's own answer says so.
#if !android
@test
private a_desktop_has_no_bars_and_a_resizable_window()
    assert(window_flags() & sh.sysl.sdl3.WINDOW_RESIZABLE != 0)
    assert_eq(insets().left + insets().top + insets().right + insets().bottom, 0)
end a_desktop_has_no_bars_and_a_resizable_window
#endif

// ## The application's frame

// **The hook is handed the step the animations get**, clamped the same way: a phone back from the
// background has been away for minutes, and a tuner that integrated over that gap would be as wrong
// as an animation that ran its whole travel at once.
@test
private the_frame_hook_is_handed_the_clamped_step()
    val heard = signal(0.0)
    val calls = signal(0)
    val hook: &Fn(real) -> unit = dt ->
        heard.set(dt)
        calls.set(calls.read() + 1)

    val (dt, _) = advance(16000000, hook, writes())

    assert(dt == 0.016, s"${dt}")
    assert(heard.read() == 0.016, "the hook sees the frame's own step")
    assert_eq(calls.read(), 1, "once a frame")

    val (away, _) = advance(90000000000, hook, writes())

    assert(away == 0.25, s"${away}")
    assert(heard.read() == 0.25, "and a long absence arrives clamped")
    assert_eq(calls.read(), 2)
end the_frame_hook_is_handed_the_clamped_step

// **A signal the hook writes rebuilds the tree on the frame that wrote it.** The hook runs before the
// comparison against what the loop last saw, so the write is already counted — the other order would
// draw every reading one frame late, which nothing but this test would notice.
@test
private a_write_in_the_hook_rebuilds_this_frame()
    val pitch = signal(0.0)
    val seen = writes()

    val (_, stale) = advance(16000000, dt -> pitch.set(440.0), seen)

    assert(stale, "the hook's write is this frame's")
    assert(pitch.read() == 440.0)
end a_write_in_the_hook_rebuilds_this_frame

// **And a hook that writes nothing leaves the tree alone**, as does the default one, so an
// application that never names the hook rebuilds exactly as often as it did before there was one.
@test
private a_quiet_hook_rebuilds_nothing()
    val (_, idle) = advance(16000000, dt -> (), writes())

    assert(!idle, "nothing written, nothing rebuilt")

    val a = app("t", () -> text("t"), () -> 0)
    val (_, defaulted) = advance(16000000, a.on_frame, writes())

    assert(!defaulted, "the default hook is quiet")
end a_quiet_hook_rebuilds_nothing

// ## Leaving the screen and coming back

// Run `kinds` through `lifecycle` from on screen, answering how many times each hook fired and
// whether the application ended away.
private trip(kinds: []const EventKind) -> (int, int, bool)
    val paused = signal(0)
    val resumed = signal(0)
    var away = false

    for k in kinds
        away = lifecycle(k, away, () -> paused.set(paused.read() + 1),
                         () -> resumed.set(resumed.read() + 1))

    (paused.read(), resumed.read(), away)
end trip

// **Either half of the way out pauses, and either half of the way back resumes**, so a platform that
// sent only one of a pair would still be heard.
@test
private each_lifecycle_event_drives_its_hook()
    assert_eq(trip([EventKind.WillEnterBackground]), (1, 0, true), "will enter background")
    assert_eq(trip([EventKind.DidEnterBackground]), (1, 0, true), "did enter background")
    assert_eq(trip([EventKind.Terminating]), (1, 0, true), "terminating")
    assert_eq(trip([EventKind.DidEnterBackground, EventKind.WillEnterForeground]), (1, 1, false),
              "will enter foreground")
    assert_eq(trip([EventKind.DidEnterBackground, EventKind.DidEnterForeground]), (1, 1, false),
              "did enter foreground")

// **The pair is one crossing, so a microphone is closed once and opened once** — the second half
// finding it already closed would be an error from the application's own stream, or worse, a second
// stream opened over the first.
@test
private a_pair_fires_its_hook_once()
    val whole = [EventKind.WillEnterBackground, EventKind.DidEnterBackground,
                 EventKind.WillEnterForeground, EventKind.DidEnterForeground]

    assert_eq(trip(whole), (1, 1, false), "out and back")
    assert_eq(trip([EventKind.WillEnterBackground, EventKind.DidEnterBackground,
                    EventKind.Terminating]), (1, 0, true), "a destroy after a pause pauses nothing")

    val twice = [EventKind.WillEnterBackground, EventKind.DidEnterBackground,
                 EventKind.WillEnterForeground, EventKind.DidEnterForeground,
                 EventKind.WillEnterBackground, EventKind.DidEnterBackground,
                 EventKind.WillEnterForeground, EventKind.DidEnterForeground]

    assert_eq(trip(twice), (2, 2, false), "every trip is its own")
end a_pair_fires_its_hook_once

// **Nothing else is a crossing.** Coming back without having left resumes nothing, a low-memory
// warning arrives while the program is still on screen, and a minimised desktop window keeps running.
@test
private an_unrelated_event_fires_nothing()
    assert_eq(trip([EventKind.MouseMotion, EventKind.KeyDown, EventKind.Quit]), (0, 0, false))
    assert_eq(trip([EventKind.LowMemory]), (0, 0, false), "low memory")
    assert_eq(trip([EventKind.WindowMinimized, EventKind.WindowRestored]), (0, 0, false),
              "minimised")
    assert_eq(trip([EventKind.WillEnterForeground, EventKind.DidEnterForeground]), (0, 0, false),
              "back without leaving")

    val a = app("t", () -> text("t"), () -> 0)

    assert(lifecycle(EventKind.DidEnterBackground, false, a.on_pause, a.on_resume),
           "the default hooks still mark the crossing")
end an_unrelated_event_fires_nothing

// ## The wheel

// **A notch away from the user moves the content down**, which is the sense the canvas answers in,
// and a notch to the right moves it left.
@test
private a_wheel_notch_is_a_step_in_the_canvas_sense()
    val (x, y) = wheel_points(0.0, 1.0)

    assert(x == 0.0, s"${x}")
    assert(y == 40.0, s"away from the user shows what is above: ${y}")

    val (rx, ry) = wheel_points(1.0, -1.0)

    assert(rx == -40.0, s"to the right moves the content left: ${rx}")
    assert(ry == -40.0, s"toward the user shows what is below: ${ry}")
end a_wheel_notch_is_a_step_in_the_canvas_sense

// **A trackpad's fractions pass through as fractions**, not rounded to a whole step either way --
// a slow glide reports a tenth of a step at a time and has to move a tenth of one.
@test
private a_precise_delta_is_not_rounded_to_a_step()
    val (_, y) = wheel_points(0.0, 0.125)
    val (x, _) = wheel_points(-0.05, 0.0)

    assert(y == 5.0, s"${y}")
    assert(x > 1.99 && x < 2.01, s"${x}")
end a_precise_delta_is_not_rounded_to_a_step

// ## The mouse

private val screen = Rect(0, 0, 100, 100)

// **A right or middle click does not tap a control**, and neither does a side button, which the
// toolkit has no name for. The left one does, and it is the only one that does.
@test
private only_the_left_button_taps_a_control()
    val n = signal(0)
    val bump: &Fn() -> unit = () -> n.set(n.read() + 1)
    val tree = text("button").on_tap(bump)

    for b in [MouseButton.Right, MouseButton.Middle, MouseButton.X1, MouseButton.X2, MouseButton.Other(9)]
        var c = recorder()

        tree.paint(&c, screen)
        mouse_down(&c, b, 5, 5)
        assert(!c.pressed(screen), "it presses nothing")
        mouse_up(&c, b, 5, 5)
        assert_eq(n.read(), 0)

    var c = recorder()

    tree.paint(&c, screen)
    mouse_down(&c, MouseButton.Left, 5, 5)
    assert(c.pressed(screen), "the left one presses")
    mouse_up(&c, MouseButton.Left, 5, 5)
    assert_eq(n.read(), 1)
end only_the_left_button_taps_a_control

@test
private a_button_tells_the_canvas_which_it_was()
    var c = recorder()

    mouse_down(&c, MouseButton.Right, 20, 30)
    assert(c.held(PointerButton.Secondary))
    assert(!c.held(PointerButton.Primary))
    assert_eq(c.pointer(), (20, 30))
    assert_eq(c.press_origin_by(PointerButton.Secondary), (20, 30))

    mouse_down(&c, MouseButton.Middle, 21, 31)
    assert(c.held(PointerButton.Middle))

    mouse_up(&c, MouseButton.Right, 22, 32)
    assert(!c.held(PointerButton.Secondary))
    assert(c.held(PointerButton.Middle), "the other stays down")
    assert_eq(c.pointer(), (22, 32))

    mouse_up(&c, MouseButton.Middle, 22, 32)
    assert(!c.held(PointerButton.Middle))
end a_button_tells_the_canvas_which_it_was

// **A side button in the middle of a right-drag says nothing about it**: not a release, not a press.
@test
private a_side_button_changes_nothing_that_is_held()
    var c = recorder()

    mouse_down(&c, MouseButton.Right, 20, 30)
    mouse_down(&c, MouseButton.X1, 20, 30)
    mouse_up(&c, MouseButton.X1, 20, 30)
    assert(c.held(PointerButton.Secondary))
    assert(!c.held(PointerButton.Primary))
    assert(!c.held(PointerButton.Middle))
end a_side_button_changes_nothing_that_is_held

@test
private the_three_buttons_have_names_and_the_rest_do_not()
    assert(button_of(MouseButton.Left) == Some(PointerButton.Primary))
    assert(button_of(MouseButton.Right) == Some(PointerButton.Secondary))
    assert(button_of(MouseButton.Middle) == Some(PointerButton.Middle))
    assert(button_of(MouseButton.X1) == None)
    assert(button_of(MouseButton.X2) == None)
    assert(button_of(MouseButton.Other(9)) == None)
end the_three_buttons_have_names_and_the_rest_do_not

// **SDL's `clicks` reaches the canvas as the tap's count**, for the primary button only; a press SDL
// counted afresh -- elsewhere, or after the double-click time -- arrives as 1 and is a single again.
@test
private sdl_counts_the_clicks_of_a_tap()
    var c = recorder()

    mouse_down(&c, MouseButton.Left, 5, 5, 1)
    assert_eq(c.tap_count(), 1, "the first press of a run")
    mouse_up(&c, MouseButton.Left, 5, 5)
    c.keys_done()

    mouse_down(&c, MouseButton.Left, 5, 5, 2)
    assert_eq(c.tap_count(), 2, "SDL said it was the second")
    mouse_up(&c, MouseButton.Left, 5, 5)
    c.keys_done()

    mouse_down(&c, MouseButton.Left, 60, 60, 1)
    assert_eq(c.tap_count(), 1, "too far or too late: SDL starts again, and so does the tap")
    mouse_up(&c, MouseButton.Left, 60, 60)
    c.keys_done()

    mouse_down(&c, MouseButton.Left, 5, 5)
    assert_eq(c.tap_count(), 1, "a press nobody counted is a single")
    mouse_up(&c, MouseButton.Left, 5, 5)
    c.keys_done()

    mouse_down(&c, MouseButton.Right, 5, 5, 2)
    assert_eq(c.tap_count(), 0, "a right-click is not a tap, double or not")
    mouse_up(&c, MouseButton.Right, 5, 5)

    mouse_down(&c, MouseButton.Left, 5, 5, 3)
    mouse_down(&c, MouseButton.Right, 5, 5, 1)
    assert_eq(c.tap_count(), 3, "and another button's count does not overwrite the primary's")
end sdl_counts_the_clicks_of_a_tap

// Every shape a view can ask for has SDL's system cursor of the same meaning.
@test
private every_shape_has_its_system_cursor()
    assert(system_cursor_of(Cursor.Arrow) == SystemCursor.Default)
    assert(system_cursor_of(Cursor.Text) == SystemCursor.Text)
    assert(system_cursor_of(Cursor.Pointer) == SystemCursor.Pointer)
    assert(system_cursor_of(Cursor.EwResize) == SystemCursor.EwResize)
    assert(system_cursor_of(Cursor.NsResize) == SystemCursor.NsResize)
    assert(system_cursor_of(Cursor.Move) == SystemCursor.Move)
    assert(system_cursor_of(Cursor.Crosshair) == SystemCursor.Crosshair)
    assert(system_cursor_of(Cursor.NotAllowed) == SystemCursor.NotAllowed)
    assert(system_cursor_of(Cursor.Wait) == SystemCursor.Wait)
end every_shape_has_its_system_cursor

// **SDL is told only on a change**: the arrow it starts with is never set, the same shape twice is
// one set, and going back to the arrow is a change like any other.
@test
private the_cursor_is_set_only_when_the_shape_changes()
    var s = shapes()

    assert(!s.changed(Cursor.Arrow), "the arrow is already showing")
    assert(s.changed(Cursor.EwResize), "a new shape")
    assert(!s.changed(Cursor.EwResize), "the same one next frame")
    assert(s.changed(Cursor.Text), "another")
    assert(s.changed(Cursor.Arrow), "and back to the arrow")
    assert(!s.changed(Cursor.Arrow))
end the_cursor_is_set_only_when_the_shape_changes

// **The canvas a frame loop reads is the one the views asked**: a request over the pointer is the
// shape after `render`, and the arrow where nothing asked.
@test
private the_frame_loop_reads_the_shape_the_views_asked_for()
    val tree = PointerReader((c, r) -> c.cursor(Rect(0, 0, 10, 100), Cursor.EwResize))
    var c = recorder()

    c.point(5, 5)
    render(tree, &c, screen)
    assert(c.shape() == Cursor.EwResize, "over the border")

    c.point(50, 5)
    render(tree, &c, screen)
    assert(c.shape() == Cursor.Arrow, "beside it")
end the_frame_loop_reads_the_shape_the_views_asked_for

// **Either side of the keyboard counts, and a lock key is not a modifier.**
@test
private the_modifier_mask_becomes_four_answers()
    assert(modifiers_of(0) == no_modifiers())
    assert(modifiers_of(KMOD_SHIFT) == Modifiers(true, false, false, false))
    assert(modifiers_of(KMOD_LSHIFT) == Modifiers(true, false, false, false))
    assert(modifiers_of(KMOD_RCTRL) == Modifiers(false, true, false, false))
    assert(modifiers_of(KMOD_ALT) == Modifiers(false, false, true, false))
    assert(modifiers_of(KMOD_GUI) == Modifiers(false, false, false, true))
    assert(modifiers_of(KMOD_SHIFT | KMOD_CTRL | KMOD_ALT | KMOD_GUI) == Modifiers(true, true, true, true))
    assert(modifiers_of(KMOD_CAPS | KMOD_NUM) == no_modifiers())
end the_modifier_mask_becomes_four_answers

// ## The font

// **A machine either has one of these or it does not**, and the honest test is that the answer is a
// file when it is not empty — not that any particular face is installed.
@test
private the_system_font_is_a_file_or_nothing()
    val path = system_font()

    assert(path == "" || is_file(path), s"'${path}'")
end the_system_font_is_a_file_or_nothing
