module sh.sysl.ui_sdl

import sh.sysl.ui.*
import sh.sysl.plutovg
import sh.sysl.sdl3.{BlendMode, PixelFormat, Renderer, ScaleMode, Surface, GpuDevice, TextureAccess, Event, EventKind,
                     init, create_window, create_gpu_renderer, gpu_device, poll_event, ticks_ns, mod_state, error,
                     set_hint, INIT_VIDEO, WINDOW_HIGH_PIXEL_DENSITY, WINDOW_RESIZABLE, Window}
import sh.sysl.sdl3.control.{Control, Request, Response, listen}
import sysl.slices.as_ptr

// Skitter is a phone framework, so only an Android build has it (the manifest's `if = "android"`),
// and a desktop program links none of it. The three things taken from it have a desktop answer here.
#if android
import sh.sysl.skitter.{insets, orient, window_flags}
#else
private[ui_sdl] struct NoInsets
    left: int
    top: int
    right: int
    bottom: int

// A desktop program has the whole window: no system bars.
private[ui_sdl] insets() -> NoInsets = NoInsets(0, 0, 0, 0)

// A desktop SDL has no orientation hint.
private[ui_sdl] orient() = ()

private[ui_sdl] window_flags() -> u64 = WINDOW_RESIZABLE
#endif

// The window, the frame loop and the events — the half of an application that is the same on every
// machine, written once.
//
// **syslUI draws and does not present**, which is the split the whole toolkit is built on: what it
// produces is a block of premultiplied ARGB32 pixels, and getting those onto a screen is somebody
// else's job. This is that somebody, for the case where the screen belongs to SDL3.
//
// **One driver rather than a desktop one and a phone one, and the measurement is why.** Of the
// hundred and twenty lines an Android frame loop takes, about seventeen were genuinely
// platform-specific — the entry point, the system bars, and one hint about orientation. Everything
// else was identical, and most of what *looked* like phone code was a desktop program taking
// shortcuts that a fixed-size, density-unaware window allows. Two packages would be two copies of
// the same loop kept in sync by hand.
//
// **What an application still owns**, and what stays outside this file:
//
//   - **the entry point**, which is `main` on a desktop and an `@export("SDL_main")` on Android,
//     because Java looks the symbol up rather than calling it;
//   - **the JNI method that reports the system bars**, whose symbol is mangled from the
//     application's own package name and so cannot live in a library — it calls `set_insets` below;
//   - **its shortcuts**: ⌘C, escape. `on_event` sees every event first, the wheel included, so an
//     application that wants the wheel for something other than scrolling answers `true` to it.

// Where the interface is drawn, what it is, and what the window is cleared to.
//
// **The tree is a function rather than a value** because it is rebuilt whenever anything has been
// written — that is what a rebuild *is*, a function of the application's state — and the loop cannot
// know which signals were read.
struct App
    title: string

    // The window to ask for, in points. **On a phone this decides only which way up the activity
    // starts**: SDL reads the requested shape, and wider-than-tall turns a phone sideways.
    width: int
    height: int

    tree: &Fn() -> &View

    // What the window is cleared to, which is the application's colour rather than the toolkit's: a
    // `Theme` says what an interface's own surfaces look like and nothing about what is behind them.
    ground: &Fn() -> u32

    // Every event, before the driver looks at it. Answer `true` to say it has been dealt with.
    //
    // **This is where a shortcut goes**, and it is deliberately the whole event rather than a
    // narrower callback: what a program wants from the keyboard is unbounded, and a driver that
    // guessed would be wrong for the second program that used it.
    on_event: &Fn(Event) -> bool

    // The application's own work, once a frame, handed the seconds since the last one.
    //
    // **This is where a program that is not driven by events does its reading** — a microphone, a
    // socket, a simulation's step. It runs after the frame's events and before the loop decides
    // whether to rebuild, so a signal written here rebuilds the tree on this same frame. It runs on
    // the loop's own thread, so it may write signals freely; and it must not block, because a frame
    // is about sixteen milliseconds and every one of them it holds is a frame the window does not
    // draw.
    on_frame: &Fn(real) -> unit

    // The application is leaving the screen, and coming back to it.
    //
    // **This is where a program gives back what the system shows it holding** — a microphone, a
    // camera, a location fix — so the indicator for it goes out while the program is away, and where
    // it takes the thing up again on return. Each runs once per trip, on the loop's own thread, and
    // `on_frame` is not called between them: see `lifecycle` for which events drive them and on which
    // machines they fire at all.
    on_pause: &Fn() -> unit
    on_resume: &Fn() -> unit

    // A font file, or the empty string to take whatever the machine has.
    font: string

    // The text size, in points.
    size: f32

    // The shader formats the application supplies, `GPU_SHADERFORMAT_MSL` and so on, which is how it
    // asks to draw with viewports. Zero means none: a plain window with no GPU device.
    gpu: u32

    // A Unix socket to be driven over, `/tmp/app.sock` say, or the empty string for none — in which
    // case nothing listens and nothing extra is drawn. See `control.sysl`.
    control: string
end App

// An application, with the parts most of them do not need already answered.
app(title: string, tree: &Fn() -> &View, ground: &Fn() -> u32, width: int = 900,
    height: int = 660, on_event: &Fn(Event) -> bool = e -> false, font: string = "",
    size: f32 = 15.0, on_frame: &Fn(real) -> unit = dt -> (), on_pause: &Fn() -> unit = () -> (),
    on_resume: &Fn() -> unit = () -> (), gpu: u32 = 0, control: string = "") -> &App =
    App(title, width, height, tree, ground, on_event, on_frame, on_pause, on_resume, font, size, gpu,
        control)

// ## What an Android application has to reach
//
// **Nothing, as of this version, and that is the change.** The system bars used to arrive here: this
// module kept four `int`s and a `set_insets` for the application's JNI entry point to call, because
// JNI mangles a native method's symbol from the *application's* package and so the `@export` could
// not live in a library.
//
// `sysl-lang/skitter` fixes the activity at `sh.sysl.skitter.SkitterActivity`, which fixes the
// symbol, which is what makes the bridge a library's — so the bars are read from there and an
// application forwards nothing. It also owns the orientation pair `run` used to write out below.
//
// **The bars are read every frame rather than stored**, which is not a cost worth avoiding: it is
// four loads of module storage that Android's UI thread wrote, and reading them at the one place
// they are used is what makes a rotation land on the next frame without anything having to notice
// it happened.

// Whether the loop should stop, and how anything says so.
//
// **One window to a process**, which is what `SDL_main` gives an Android program anyway and what
// every desktop program here wants. A second window would want this to be a field.
var stopped: bool = false

// End the frame loop. An application calls this from a button, a shortcut or a menu.
stop() = stopped = true

// The window `run` opened, while it is running — what a file dialog or a message box takes as its
// parent. `None` before `run` has made it and after `run` has returned.
window() -> Option[&Window] = live
private var live: Option[&Window] = None

// Retitle the running window. `false` when there is none, or SDL refused.
set_title(title: string) -> bool =
    live match
        Some(w) -> w.set_title(title)
        None -> false

// The file the next finished frame is written to, or nothing.
private var shot_to: string = ""

// Write the next frame to a PNG, read back from the renderer: what the window is about to show, the 3D
// included, rather than a capture of the desktop.
save_frame(file: string) = shot_to = file

// Write the frame in the renderer's target to the file, if one was asked for. A failure is printed,
// since the frame it would have written is still a good frame.
private take_shot(renderer: &Renderer)
    if shot_to == "" then return

    val file = shot_to

    shot_to = ""

    val written = renderer.read_pixels().and_then(s -> s.convert(PixelFormat.Argb8888)).map(s -> png_of(s, file))

    if written != Some(true) then print(s"the frame could not be written to ${file}: ${error()}")
end take_shot

// The SDL surface as a PNG, through PlutoVG's encoder: both hold ARGB32, row by row. Forced opaque,
// because what a window shows has no alpha and some renderers leave the channel as it was cleared.
private png_of(s: &Surface, file: string) -> bool
    val w = int(s.width())
    val h = int(s.height())
    val out = plutovg.surface(w, h).expect("a surface for the frame")
    val to = out.data()
    val from = s.pixels()

    for y in 0..<h
        for x in 0..<w * 4
            to[y * out.stride() + x] = if x % 4 == 3 then 255 else from[y * int(s.pitch()) + x]

    out.write_png(file)
end png_of

// ## The loop

// The application's share of a frame: how long the frame was, the application's own work, and whether
// the tree has to be built again — answered as the step and that decision.
//
// **The hook runs before the decision**, so a signal it writes is seen by the comparison that follows
// and the tree is rebuilt on the frame that wrote it rather than one frame late. It is a function of
// its own rather than lines inside `run` because it is the part of the loop a test can reach without
// a window.
private[ui_sdl] advance(elapsed_ns: u64, on_frame: &Fn(real) -> unit, seen: int) -> (real, bool)
    var dt = real(elapsed_ns) / 1.0e9

    // An application sent to the background stops the loop for as long as it is away, and an
    // unclamped step would put every animation through its whole travel on the way back.
    if dt > 0.25 then dt = 0.25

    on_frame(dt)

    // **`writes()` is one counter for the whole application**, compared against what the loop last
    // saw. A `dirty` signal registered on every piece of state is a line per signal and the one
    // somebody forgets is a control that draws correctly and silently never updates.
    (dt, writes() != seen)
end advance

// Whether the application is away from the screen after `kind`, calling the hook for a crossing.
//
// **Each direction arrives as a pair, and the hook belongs to whichever half comes first.** SDL sends
// `WillEnterBackground` then `DidEnterBackground`, and on the way back `WillEnterForeground` then
// `DidEnterForeground`; `away` is what makes the second half of a pair do nothing. The earlier half is
// the right one to act on going out, since the sooner a microphone is closed the sooner its indicator
// goes out, and nothing about coming back needs the later one.
//
// **`Terminating` is a pause too**, when nothing paused first: a program being destroyed is leaving
// the screen for good, and what `on_pause` gives back is exactly what it should not still hold.
// `LowMemory` is not — the program is still on screen — and every other event leaves `away` alone.
//
// **Where these fire.** On Android, from the activity's `onPause` and `onResume`: the Home button,
// another app in front, the screen going off. SDL 3.4 handles those on this loop's own thread, inside
// the event pump, so they arrive through `poll_event` before anything is suspended — which is why the
// queue is enough here, the header's advice to use an event watch notwithstanding. iOS sends the same
// four. **A desktop sends none of them**: minimising a window is `WindowMinimized` and
// `WindowRestored`, the program keeps running, and a hook that closed a microphone there would cut off
// a recorder somebody had merely tucked out of the way.
private[ui_sdl] lifecycle(kind: EventKind, away: bool, on_pause: &Fn() -> unit,
                          on_resume: &Fn() -> unit) -> bool
    val leaving = kind == EventKind.WillEnterBackground || kind == EventKind.DidEnterBackground ||
                  kind == EventKind.Terminating
    val returning = kind == EventKind.WillEnterForeground || kind == EventKind.DidEnterForeground

    if leaving && !away
        on_pause()
        true
    elif returning && away
        on_resume()
        false
    else
        away
end lifecycle

// How far a wheel event moves the content, in points and in the sense `Canvas.wheel` answers in:
// positive `y` moves the content down.
//
// **SDL's `y` is positive away from the user, which is already that sense** -- turning a wheel away
// shows what is above -- and its `x` is positive to the right, which moves the content left.
//
// **SDL's `direction` is deliberately not read.** `FLIPPED` says the platform has applied natural
// scrolling, so the values are already the ones the person asked for; multiplying them back is how a
// game recovers which way the hardware turned, and for a list it would undo the setting.
//
// **A trackpad's deltas are fractions of a step and pass through as fractions**, never rounded to
// whole lines: the canvas adds them up, so a slow glide moves the content a point at a time rather
// than not at all. A notched wheel reports whole steps, and a step is `WHEEL_STEP` points.
private[ui_sdl] wheel_points(x: f32, y: f32) -> (real, real) =
    (-real(x) * WHEEL_STEP, real(y) * WHEEL_STEP)

// One notch of a wheel, in points: two and a half rows of sixteen-point text, about what a desktop
// moves a document by.
private const WHEEL_STEP: real = 40.0

// Where the pointer is until the first mouse event says otherwise: off the surface, as `Canvas.pointer`
// answers from a backend with no pointer. Starting at the origin would light whatever sits in the corner.
private[ui_sdl] const NO_POINTER: int = -1

// Open the window and run until something stops it.
//
// **The frame is drawn every time round whether anything changed or not**, and that is not waste: a
// hover easing toward its colour is a change to the *picture* and not to the state, so a loop that
// only repainted after a rebuild would animate in steps of one tap.
run(a: &App) -> Result[unit, string]
    // **Before `init`, because a hint is read when the thing it configures is created**, and on
    // Android the activity's orientation is decided during startup. Skitter's, because the hint
    // alone is not enough — `SDLActivity.setOrientationBis` only promotes "all four allowed" into
    // *follow the device* when the window is also resizable, and `window_flags` below is the other
    // half of the same setting. Both are harmless on a desktop, which has no such hint.
    orient()

    // **A trackpad on a Mac glides on after the fingers lift, and SDL drops that unless asked**, so
    // a list would stop dead under a flick every other program there carries on with. It is read at
    // `init`, and every other platform ignores it.
    set_hint("SDL_MAC_SCROLL_MOMENTUM", "1")

    if !init(INIT_VIDEO) then return Err(s"SDL would not start: ${error()}")

    val path = if a.font != "" then a.font else system_font()

    if path == "" then return Err("no font this driver knows about is on this machine")

    // **Only a window asking for the display's density gets it**, so a Mac's other windows here are drawn
    // at one pixel to a point and magnified by the system. A viewport wants the real pixels.
    val density = if a.gpu != 0 then WINDOW_HIGH_PIXEL_DENSITY else 0u64
    val window = create_window(a.title, i32(a.width), i32(a.height),
                               window_flags() | density).expect("a window")

    // **An application with viewports has its renderer on a GPU device**, and one without never makes a
    // device. The device is declared first so it outlives the renderer, as SDL requires.
    val device = if a.gpu != 0 then
                     gpu_device(a.gpu) match
                         Ok(d) -> Some(d)
                         Err(e) -> return Err(s"no GPU device: ${e}")
                 else
                     None
    val renderer = device match
        Some(d) -> create_gpu_renderer(window, d).expect("a renderer on the GPU device")
        None -> window.create_renderer().expect("a renderer")
    val face = plutovg.font(path).expect(s"the font at ${path} opened")

    renderer.set_vsync(true)
    stopped = false

    // The surface, its canvas and the texture are the size of the window in **pixels**, and all
    // three are rebuilt when that changes — which on a phone means when it is turned. They start at
    // one pixel because the first frame rebuilds them anyway, and asking SDL for the size before the
    // window exists is the other way to get this wrong.
    var have_w = 0
    var have_h = 0
    var surf = plutovg.surface(1, 1).expect("a drawing surface")
    var vg = plutovg.canvas(surf).expect("a drawing canvas")
    var tex = renderer.create_texture(PixelFormat.Argb8888, TextureAccess.Streaming, i32(1),
                                      i32(1)).expect("a streaming texture")
    var c = pluto_canvas(vg, face, a.size)

    var tree = (a.tree)()

    // **The socket is opened only when one was named**, so an application without it listens on
    // nothing. The route is held in a local for the whole run rather than written inline, so the
    // closure the control keeps outlives every call it answers.
    val shown: &Shown = Shown(None)
    val route: &Fn(Request) -> Option[Response] = req -> answer(shown, req)
    val control: Option[&Control] = if a.control == "" then None else
        listen(a.control, Some(window)) match
            Ok(ctl) -> Some(ctl)
            Err(e) -> return Err(s"the control socket: ${e}")

    control match
        Some(ctl) -> ctl.route(route)
        None -> ()

    live = Some(window)

    var seen = writes() - 1
    var mx = NO_POINTER
    var my = NO_POINTER
    var down = false
    var focused = NOBODY
    var away = false
    var last = ticks_ns()

    while !stopped
        val (pw, ph) = window.size_in_pixels()
        val (ww, wh) = window.size()
        val k = scale_of(window.display_scale())

        if int(pw) != have_w || int(ph) != have_h
            surf = plutovg.surface(int(pw), int(ph)).expect("a drawing surface")
            vg = plutovg.canvas(surf).expect("a drawing canvas")
            tex = renderer.create_texture(PixelFormat.Argb8888, TextureAccess.Streaming, pw, ph)
                          .expect("a streaming texture")

            // **A window resized under a held button keeps that button's drag**, as `down` keeps
            // the primary's.
            val held = c.chord

            c = pluto_canvas(vg, face, a.size)
            c.chord = held
            have_w = int(pw)
            have_h = int(ph)
            focused = NOBODY

            device match
                Some(d) ->
                    tex.set_blend_mode(BlendMode.Premultiplied)
                    tex.set_scale_mode(ScaleMode.Nearest)
                    place_stage(d, renderer, vg, k)
                None -> ()

        val to_point = point_scale(int(ww), int(pw), k)

        // Before the events, so what a command pushed this frame is drained with them.
        control match
            Some(ctl) -> ctl.poll()
            None -> ()

        loop
            poll_event() match
                Some(e) ->
                    if (a.on_event)(e) then continue

                    val kind = e.kind()

                    away = lifecycle(kind, away, a.on_pause, a.on_resume)

                    if kind == EventKind.Quit then stopped = true

                    // **Typed text arrives already composed**, which is why a field takes a run of
                    // text rather than a character.
                    elif kind == EventKind.TextInput
                        c.key(typed(e.text()))
                    elif kind == EventKind.KeyDown
                        press_of(e.key_scancode(), e.key_mod()) match
                            Some(p) -> c.key(p)
                            None -> ()

                    // **A tap is a mouse button**, because SDL synthesises mouse events from touch
                    // unless it is told otherwise — which is why nothing here handles a finger.
                    elif kind == EventKind.MouseButtonDown
                        mx = int(real(e.mouse_x()) * to_point)
                        my = int(real(e.mouse_y()) * to_point)
                        mouse_down(&c, e.mouse_button(), mx, my)
                        down = c.down
                    elif kind == EventKind.MouseMotion
                        mx = int(real(e.mouse_x()) * to_point)
                        my = int(real(e.mouse_y()) * to_point)
                    elif kind == EventKind.MouseButtonUp
                        mx = int(real(e.mouse_x()) * to_point)
                        my = int(real(e.mouse_y()) * to_point)
                        mouse_up(&c, e.mouse_button(), mx, my)
                        down = c.down
                    elif kind == EventKind.MouseWheel
                        val (dx, dy) = wheel_points(e.wheel_x(), e.wheel_y())

                        c.spin(dx, dy)
                None -> break

        // **Nothing is drawn while the application is away**, and the application's own frame work
        // stops with it. On Android this costs nothing to say: under SDL's default
        // `SDL_ANDROID_BLOCK_ON_PAUSE` the next `poll_event` does not return until the activity is
        // resumed, so the loop is parked in the pump rather than spinning. With that hint set to "0"
        // the pump wakes every tenth of a second instead, and this is what keeps those wake-ups from
        // being frames — a surface nobody can see, rendered ten times a second on a battery. The clock
        // starts again from here, so the first frame back is handed one frame's step rather than the
        // whole absence.
        if away
            last = ticks_ns()
            continue

        // **The on-screen keyboard is asked for and dismissed by focus**, which is the one place a
        // phone needs the toolkit to answer a question rather than the other way round. On a desktop
        // both calls are harmless, and `start_text_input` is needed there anyway or SDL sends no
        // typed text at all.
        if c.focus() != focused
            focused = c.focus()

            if focused == NOBODY then window.stop_text_input() else window.start_text_input()

        val now = ticks_ns()
        val (dt, stale) = advance(now - last, a.on_frame, seen)

        last = now

        if stale
            tree = (a.tree)()
            seen = writes()

        c.point(mx, my, down)
        c.chord.keys = modifiers_of(mod_state())
        c.tick(dt)
        c.taps.reset()

        val bg = (a.ground)()
        val paint_began = ticks_ns()

        surf.clear(fraction(bg, 16), fraction(bg, 8), fraction(bg, 0))

        // **The scale is set on the canvas rather than applied to the layout**, so a rounded corner
        // and a glyph are rasterized at the pixel size they end up at. Scaling the finished picture
        // instead would be one bilinear blur over the whole interface.
        vg.reset_transform()
        vg.scale(f32(k), f32(k))

        // **`render` rather than `measure` and `paint`**, because a frame is the tree *and* whatever
        // the tree raised above itself — and because it is what ends the frame's keys.
        //
        // **The bars are asked for here, once a frame.** Android reports them before the first frame
        // and again on every rotation, and reading them at the point they are used is what makes a
        // turned phone land on the next frame rather than on the next signal write. On a desktop
        // they are all zero, which is the honest answer for a program that has a whole window.
        val ins = insets()

        val at = frame_rect(int(pw), int(ph), k, ins.left, ins.top, ins.right, ins.bottom)

        render(tree, &c, at)

        if control.is_some() then shown.snap = Some(snapshot(tree, &c, at))

        // A window coordinate, which is what the controlled pointer is in, to the renderer's pixels.
        val to_pixel = if ww > 0 then f32(pw) / f32(ww) else 1.0f32

        stage match
            Some(s) ->
                gpu_frame(s, tex, as_ptr(surf.data()), i32(surf.stride()), paint_began, () ->
                    overlay(control, renderer, to_pixel)
                    take_shot(renderer)
                    renderer.present()
                )
            None ->
                tex.update(as_ptr(surf.data()), i32(surf.stride()))
                renderer.clear()
                renderer.copy(tex)
                overlay(control, renderer, to_pixel)
                take_shot(renderer)
                renderer.present()

    // The viewports outlive this call and what they show dies with the renderer.
    stage match
        Some(s) ->
            device.unwrap().wait_idle()
            s.release()
            stage = None
        None -> ()

    live = None

    control match
        Some(ctl) -> ctl.close()
        None -> ()

    Ok(())
end run

// What a frame under control owes before it is presented: the pointer drawn over it, then the frame
// read back if a client asked for it — so a `/shot` shows what the person watching sees.
private[ui_sdl] overlay(control: Option[&Control], renderer: &Renderer, to_pixel: f32)
    control match
        Some(ctl) ->
            mark_pointer(renderer, ctl.pointer(), to_pixel)
            ctl.capture(renderer)
        None -> ()
end overlay

// Point the stage at the canvas of the current surface, keeping the viewports it has seen. A surface's
// canvas is replaced whenever the window changes size.
private place_stage(device: &GpuDevice, renderer: &Renderer, vg: &plutovg.Canvas, k: real)
    stage match
        Some(s) ->
            s.vg = vg
            s.k = k
        None -> stage = Some(stage_on(device, renderer, vg, k))
end place_stage
