module sh.sysl.ui_sdl
@tests

// Driving a running application over its socket. The routes and the pointer marker are tested on their
// own, and then `run` itself, on SDL's dummy video driver, with the test as the client: `on_frame` is
// where it sends, and a frame goes by between each look at the socket, exactly as a `curl` in another
// process would see it.

import sh.sysl.ui.*
import sh.sysl.sdl3.{HINT_VIDEO_DRIVER, INIT_VIDEO, MouseButton, PixelFormat, Renderer, Surface, WINDOW_HIDDEN, Window, create_window,
                     init, rgb, set_hint, ticks_ns}
import sh.sysl.sdl3.c
import sh.sysl.sdl3.control.{Forward, Header, Pass, Pointer, Request, Respond, Routed, listen}
import sh.sysl.png
import sysl.buf.{Buf, buf}
import sysl.encoding.json
import sysl.fs.{exists, make_temp_dir, remove_dir_all}
import sysl.net.{Socket, unix, unix_connect, would_block}
import sysl.path.join
import sysl.text.{Search, from_cstring, from_utf8_lossy}

// sdl3 binds `set_title` and nothing that reads the title back, so the check asks SDL directly.
extern "SDL_GetWindowTitle" window_title(w: *c.Window) -> *u8

private request_of(method: string, path: string) -> Request =
    Request(method, path, "", buf(), buf())

private body_of(r: sh.sysl.sdl3.control.Response) -> string = from_utf8_lossy(r.body.view())

private val screen = Rect(0, 0, 200, 100)

private save_button(n: &Signal[int]) -> &View =
    column([button("Save", () -> n.set(n.read() + 1)).named("save"), text("ready")])

// ## The route

@test
private the_snapshot_route_leaves_every_other_path_to_sdl3()
    val s: &Shown = Shown(None, 1.0)

    assert(answer(s, request_of("GET", "/state")).is_none())
    assert(answer(s, request_of("POST", "/click")).is_none())
    assert(answer(s, request_of("GET", "/snapshots")).is_none())
end the_snapshot_route_leaves_every_other_path_to_sdl3

@test
private the_snapshot_route_takes_only_get()
    val s: &Shown = Shown(None, 1.0)
    val r = answer(s, request_of("POST", "/snapshot")).unwrap()

    assert_eq(r.status, 405)
    assert_eq(r.allow, "GET")
end the_snapshot_route_takes_only_get

@test
private before_the_first_frame_there_is_nothing_to_snapshot()
    val r = answer(Shown(None, 1.0), request_of("GET", "/snapshot")).unwrap()

    assert_eq(r.status, 503)
    assert(body_of(r).contains("no frame"), body_of(r))
end before_the_first_frame_there_is_nothing_to_snapshot

@test
private the_snapshot_route_answers_the_frame_as_json()
    val n = signal(0)
    val tree = save_button(n)
    var c = recorder()

    render(tree, &c, screen)

    val s: &Shown = Shown(Some(snapshot(tree, &c, screen)), 1.0)
    val r = answer(s, request_of("GET", "/snapshot")).unwrap()

    assert_eq(r.status, 200)
    assert_eq(r.content_type, "application/json")

    val parsed = json.parse(body_of(r)).unwrap()
    val entries = parsed.get("entries").unwrap()
    var found = false

    for i in 0..<entries.len()
        val e = entries.at(i).unwrap()

        if e.get("ref").unwrap().as_str() == Some("save")
            found = true
            assert_eq(e.get("role").unwrap().as_str(), Some("button"))
            assert_eq(e.get("label").unwrap().as_str(), Some("Save"))

    assert(found, body_of(r))
    assert_eq(body_of(r), snapshot(tree, &c, screen).to_json() + "\n", "exactly syslUI's own JSON")
end the_snapshot_route_answers_the_frame_as_json

// ## The pointer drawn over the frame

// The pixel at `x`, `y` of a frame read back, as red, green and blue: ARGB32 is B, G, R, A in memory.
private pixel(s: &Surface, x: int, y: int) -> (u8, u8, u8)
    val from = s.pixels()
    val at = y * int(s.pitch()) + x * 4

    (from[at + 2], from[at + 1], from[at])
end pixel

private read_back(r: &Renderer) -> &Surface = r.read_pixels().unwrap().convert(PixelFormat.Argb8888).unwrap()

// A hidden window's renderer, cleared to black. The window is handed back too, since the renderer
// draws into nothing once its window has gone.
private headless() -> (&Window, &Renderer)
    set_hint(HINT_VIDEO_DRIVER, "dummy")
    assert(init(INIT_VIDEO), "SDL came up headless")

    val window = create_window("marks", 64, 64, WINDOW_HIDDEN).unwrap()
    val r = window.create_renderer().unwrap()

    r.clear_to(rgb(0, 0, 0))
    (window, r)
end headless

// Not `BLACK` and `WHITE`: syslUI's colours of those names, reached through `sh.sysl.ui.*`, are taken
// over this module's own by sysl 0.8.9.
private val MAGENTA: (u8, u8, u8) = (230, 40, 140)
private val CLEARED: (u8, u8, u8) = (0, 0, 0)
private val RING: (u8, u8, u8) = (255, 255, 255)

@test
private the_pointer_is_a_ringed_dot_where_it_is()
    val (w, r) = headless()

    mark_pointer(r, Pointer(20.0, 30.0, false, MouseButton.Left, true), 1.0)

    val p = read_back(r)

    assert_eq(pixel(p, 20, 30), MAGENTA, "the dot")
    assert_eq(pixel(p, 26, 30), RING, "its ring")
    assert_eq(pixel(p, 20, 40), CLEARED, "nothing beyond it")
    assert_eq(pixel(p, 7, 30), CLEARED, "and no press square while nothing is held")
end the_pointer_is_a_ringed_dot_where_it_is

@test
private a_held_button_draws_a_square_round_the_pointer()
    val (w, r) = headless()

    mark_pointer(r, Pointer(30.0, 30.0, true, MouseButton.Left, true), 1.0)

    val p = read_back(r)

    assert_eq(pixel(p, 30, 30), MAGENTA, "the dot")
    assert_eq(pixel(p, 30 - 13, 30), MAGENTA, "the square's left side")
    assert_eq(pixel(p, 30 + 14, 30 + 5), MAGENTA, "its right side")
    assert_eq(pixel(p, 30 - 10, 30), CLEARED, "and nothing between the dot and the square")
end a_held_button_draws_a_square_round_the_pointer

@test
private the_marks_are_scaled_to_the_renderers_pixels()
    val (w, r) = headless()

    mark_pointer(r, Pointer(10.0, 10.0, false, MouseButton.Left, true), 2.0)

    val p = read_back(r)

    assert_eq(pixel(p, 20, 20), MAGENTA, "a window coordinate is two pixels")
    assert_eq(pixel(p, 8, 8), CLEARED, "not one, where an unscaled dot would cover this")
    assert_eq(pixel(p, 31, 20), RING, "and the ring is twice as wide")
end the_marks_are_scaled_to_the_renderers_pixels

@test
private a_pointer_not_yet_moved_draws_nothing()
    val (w, r) = headless()

    mark_pointer(r, Pointer(20.0, 20.0, true, MouseButton.Left, false), 1.0)

    val p = read_back(r)

    for y in 0..<64
        for x in 0..<64
            assert_eq(pixel(p, x, y), CLEARED)
end a_pointer_not_yet_moved_draws_nothing

@test
private without_a_socket_the_overlay_draws_nothing()
    val (w, r) = headless()

    overlay(None, r, 1.0)

    val p = read_back(r)

    for y in 0..<64
        for x in 0..<64
            assert_eq(pixel(p, x, y), CLEARED)
end without_a_socket_the_overlay_draws_nothing

@test
private the_marks_leave_the_draw_colour_black_for_the_next_clear()
    val (w, r) = headless()

    mark_pointer(r, Pointer(30.0, 30.0, true, MouseButton.Left, true), 1.0)
    r.clear()

    assert_eq(pixel(read_back(r), 30, 30), CLEARED)
end the_marks_leave_the_draw_colour_black_for_the_next_clear

// ## The whole loop, driven over its socket

// A client on the loop's own thread: it sends from `on_frame`, and reads what has come back each frame.
private struct Client
    socket: Socket
    got: Buf[u8]
    over: bool

private send(at: string, method: string, target: string, body: string = "") -> &Client
    var s = unix_connect(unix(at).unwrap()).unwrap()

    s.non_blocking().unwrap()
    s.send_all(f"$method $target HTTP/1.1\r\nHost: app\r\nContent-Length: ${body.len}\r\n\r\n$body".bytes).unwrap()
    Client(s, buf(), false)
end send

private drain(cl: &Client)
    var into: []u8 = [0; 65536]

    loop
        cl.socket.recv(into) match
            Ok(n) ->
                if n == 0
                    cl.over = true
                    _ = cl.socket.close()
                    return

                cl.got.extend(into[0..<n])
            Err(e) ->
                if !would_block(e) then cl.over = true

                return
end drain

private status_of(cl: &Client) -> int =
    sysl.text.parse_int(from_utf8_lossy(cl.got.view())[9..<12]).unwrap_or(0)

private body_bytes(cl: &Client) -> []u8
    val at = cl.got.view().index_of("\r\n\r\n".bytes).unwrap()

    cl.got.view()[at + 4..<cl.got.len()]
end body_bytes

// What the script saw, read after `run` returns.
private struct Script
    at: string
    taps: &Signal[int]
    step: int
    frames: int
    started: u64
    client: Option[&Client]
    had_window: bool
    titled: bool
    title: string
    snapshot_status: int
    click: (int, int)
    click_status: int
    taps_after_click: int
    shot_status: int
    dot: (u8, u8, u8)
    far: (u8, u8, u8)

// The point the snapshot gives for `ref`, or (-1, -1).
private click_of(body: string, key: string) -> (int, int)
    val entries = json.parse(body).unwrap().get("entries").unwrap()

    for i in 0..<entries.len()
        val e = entries.at(i).unwrap()

        if e.get("ref").unwrap().as_str() == Some(key)
            val pt = e.get("click").unwrap()

            return (int(pt.at(0).unwrap().as_real().unwrap()), int(pt.at(1).unwrap().as_real().unwrap()))

    (-1, -1)
end click_of

// One frame of the script: send, or read what came back and send the next thing.
private drive(s: &Script)
    s.frames += 1

    // Ten seconds of frames is a script that will never finish, and the asserts after `run` say where.
    if s.frames == 1 then s.started = ticks_ns()
    if ticks_ns() - s.started > 10000000000u64 then stop()

    s.client match
        Some(cl) ->
            drain(cl)

            if !cl.over then return

            s.client = None

            if s.step == 1
                s.snapshot_status = status_of(cl)
                s.click = click_of(from_utf8_lossy(body_bytes(cl)), "save")
                s.client = Some(send(s.at, "POST", "/click", f"x=${s.click.0}&y=${s.click.1}"))
                s.step = 2
            elif s.step == 2
                s.click_status = status_of(cl)
                s.taps_after_click = s.taps.read()
                s.client = Some(send(s.at, "GET", "/shot"))
                s.step = 3
            else
                s.shot_status = status_of(cl)

                val image = png.decode(body_bytes(cl)).unwrap()
                val d = image.at(usize(s.click.0), usize(s.click.1))
                val f = image.at(usize(s.click.0), usize(s.click.1 + 40))

                s.dot = (d.r, d.g, d.b)
                s.far = (f.r, f.g, f.b)
                stop()
        None ->
            if s.step != 0 then return

            s.had_window = window().is_some()
            s.titled = set_title("driven")
            s.title = from_cstring(window_title(window().unwrap().handle)).unwrap()
            s.client = Some(send(s.at, "GET", "/snapshot"))
            s.step = 1
end drive

@test
private a_running_application_is_driven_over_its_socket()
    set_hint(HINT_VIDEO_DRIVER, "dummy")

    val dir = make_temp_dir("syslui-ctl-").unwrap()
    val at = join(dir, "app.sock")
    val taps = signal(0)
    val tree = save_button(taps)
    val s: &Script = Script(at, taps, 0, 0, 0, None, false, false, "", 0, (-1, -1), 0, 0, 0, CLEARED, CLEARED)
    val on_tree: &Fn() -> &View = () -> tree
    val on_ground: &Fn() -> u32 = () -> 0x000000u32
    val on_frame: &Fn(real) -> unit = dt -> drive(s)

    assert(window().is_none(), "no window before run")

    run(app("ctl", on_tree, on_ground, width = 240, height = 160, on_frame = on_frame, control = at)).unwrap()

    assert(s.had_window, "the window is handed out while it runs")
    assert(s.titled, "and it takes a new title")
    assert_eq(s.title, "driven")
    assert_eq(s.snapshot_status, 200)
    assert(s.click.0 > 0 && s.click.1 > 0, "the snapshot names the button and where to click it")
    assert_eq(s.click_status, 200)
    assert_eq(taps.read(), 1, "the click reached the button through SDL's own events")
    assert_eq(s.taps_after_click, 1, "by the time the click was answered")
    assert_eq(s.shot_status, 200)
    assert_eq(s.dot, MAGENTA, "the shot shows the pointer where it clicked")
    assert(s.far != MAGENTA, "and only there")
    assert(window().is_none(), "no window after run")
    assert(!set_title("gone"), "nor a title to set")
    assert(!exists(at), "the socket goes when run returns")
    remove_dir_all(dir).unwrap()
end a_running_application_is_driven_over_its_socket

// ## A click named by reference

private click_request(query: string, method: string = "POST") -> Request =
    Request(method, "/click", query, buf(), buf())

private shown_of(v: &View, scale: real) -> &Shown
    var c = recorder()

    render(v, &c, screen)
    Shown(Some(snapshot(v, &c, screen)), scale)
end shown_of

private forwarded(r: Routed) -> Request
    r match
        Forward(req) -> req
        _ -> panic("expected a forwarded request")
end forwarded

private refused(r: Routed) -> sh.sysl.sdl3.control.Response
    r match
        Respond(resp) -> resp
        _ -> panic("expected an answer")
end refused

@test
private a_click_by_reference_is_forwarded_to_sdl3_at_the_controls_window_coordinate()
    val s = shown_of(save_button(signal(0)), 1.0)
    val req = forwarded(click_route(s, click_request("ref=save")))

    assert_eq(req.method, "POST")
    assert_eq(req.path, "/click")
    assert_eq(req.param("x"), Some("100.5"), "the middle of the button, as a window coordinate")
    assert_eq(req.param("y"), Some("16.5"))
end a_click_by_reference_is_forwarded_to_sdl3_at_the_controls_window_coordinate

@test
private on_a_dense_display_the_window_coordinate_is_the_point_divided_by_the_scale()
    val s = shown_of(save_button(signal(0)), 2.0)
    val req = forwarded(click_route(s, click_request("ref=save")))

    // The loop turns a window coordinate into a point by multiplying by the same scale, and
    // truncating: the point the snapshot named has to come back out.
    assert_eq(req.param("x"), Some("50.25"))
    assert_eq(req.param("y"), Some("8.25"))
    assert_eq(int(50.25 * 2.0), 100)
    assert_eq(int(8.25 * 2.0), 16)
end on_a_dense_display_the_window_coordinate_is_the_point_divided_by_the_scale

@test
private the_other_parameters_of_a_click_by_reference_go_on_to_sdl3()
    val s = shown_of(save_button(signal(0)), 1.0)
    val req = forwarded(click_route(s, click_request("ref=save&clicks=2&button=right")))

    assert_eq(req.param("clicks"), Some("2"))
    assert_eq(req.param("button"), Some("right"))
    assert_eq(req.param("x"), Some("100.5"))
end the_other_parameters_of_a_click_by_reference_go_on_to_sdl3

@test
private an_unknown_reference_is_404_and_names_it()
    val r = refused(click_route(shown_of(save_button(signal(0)), 1.0), click_request("ref=nowhere")))

    assert_eq(r.status, 404)
    assert(body_of(r).contains("nowhere"), body_of(r))
end an_unknown_reference_is_404_and_names_it

@test
private a_covered_control_is_409_with_the_reason()
    val v = button("back", () -> ()).named("back").modal(signal(true), button("ok", () -> ()).named("ok"))
    val s = shown_of(v, 1.0)
    val r = refused(click_route(s, click_request("ref=back")))

    assert_eq(r.status, 409)
    assert(body_of(r).contains("raised above"), body_of(r))
    assert(forwarded(click_route(s, click_request("ref=ok"))).param("x").is_some(), "what is above it can be clicked")
end a_covered_control_is_409_with_the_reason

@test
private an_ambiguous_name_is_409_and_says_so()
    val v = column([button("one", () -> ()).named("d"), button("two", () -> ()).named("d")])
    val r = refused(click_route(shown_of(v, 1.0), click_request("ref=d")))

    assert_eq(r.status, 409)
    assert(body_of(r).contains("names two"), body_of(r))
end an_ambiguous_name_is_409_and_says_so

@test
private a_click_by_reference_before_the_first_frame_is_503()
    val r = refused(click_route(Shown(None, 1.0), click_request("ref=save")))

    assert_eq(r.status, 503)
end a_click_by_reference_before_the_first_frame_is_503

@test
private a_click_with_coordinates_or_the_wrong_method_is_left_alone()
    val s = shown_of(save_button(signal(0)), 1.0)

    assert(matches_pass(click_route(s, click_request("x=10&y=10"))), "no ref")
    assert(matches_pass(click_route(s, click_request(""))), "nothing at all")
    assert(matches_pass(click_route(s, click_request("ref=save", "GET"))), "sdl3 answers a GET its own 405")
    assert(matches_pass(click_route(s, Request("POST", "/key", "ref=save", buf(), buf()))), "another path")
    assert(matches_pass(click_route(Shown(None, 1.0), click_request("x=10&y=10"))), "even before a frame")
end a_click_with_coordinates_or_the_wrong_method_is_left_alone

private matches_pass(r: Routed) -> bool
    r match
        Pass -> true
        _ -> false
end matches_pass

// The loop itself, with a click named by reference sent over the socket between frames.
private struct Named
    at: string
    taps: &Signal[int]
    targets: Buf[string]
    next: usize
    client: Option[&Client]
    statuses: Buf[int]
    taps_at: Buf[int]
    frames: int
    started: u64

private drive_named(s: &Named)
    s.frames += 1

    if s.frames == 1 then s.started = ticks_ns()
    if ticks_ns() - s.started > 10000000000u64 then stop()

    s.client match
        Some(cl) ->
            drain(cl)

            if !cl.over then return

            s.statuses.push(status_of(cl))
            s.taps_at.push(s.taps.read())
            s.client = None
        None -> ()

    if s.next >= s.targets.len()
        stop()
        return

    s.client = Some(send(s.at, "POST", s.targets.at(s.next)))
    s.next += 1
end drive_named

@test
private a_click_by_reference_lands_in_the_named_control_in_a_running_application()
    set_hint(HINT_VIDEO_DRIVER, "dummy")

    val dir = make_temp_dir("syslui-ctl-").unwrap()
    val at = join(dir, "app.sock")
    val taps = signal(0)
    val tree = save_button(taps)
    val targets: Buf[string] = buf()

    // The last click is plain coordinates, below the button, which a click by reference must not disturb.
    for t in ["/click?ref=save", "/click?ref=nowhere", "/click?x=10&y=90", "/click?ref=save"]
        targets.push(t)

    val s: &Named = Named(at, taps, targets, 0, None, buf(), buf(), 0, 0)
    val on_tree: &Fn() -> &View = () -> tree
    val on_ground: &Fn() -> u32 = () -> 0x000000u32
    val on_frame: &Fn(real) -> unit = dt -> drive_named(s)

    run(app("ctl", on_tree, on_ground, width = 240, height = 160, on_frame = on_frame, control = at)).unwrap()

    assert_eq(s.statuses.len(), 4)
    assert_eq(s.statuses.at(0), 200)
    assert_eq(s.taps_at.at(0), 1, "the named button's handler had run by the time the click was answered")
    assert_eq(s.statuses.at(1), 404)
    assert_eq(s.taps_at.at(1), 1)
    assert_eq(s.statuses.at(2), 200, "plain coordinates still go straight to sdl3")
    assert_eq(s.taps_at.at(2), 1, "and landed below the button")
    assert_eq(s.statuses.at(3), 200)
    assert_eq(s.taps_at.at(3), 2)
    remove_dir_all(dir).unwrap()
end a_click_by_reference_lands_in_the_named_control_in_a_running_application

private struct Quiet
    frames: int
    had_window: bool
    listening: bool
    probe: string
    saved: string

private quiet_frame(q: &Quiet)
    q.frames += 1

    if q.frames == 1
        q.had_window = window().is_some()
        q.listening = exists(q.probe)
        save_frame(q.saved)
    elif q.frames >= 3
        stop()
end quiet_frame

@test
private without_a_socket_nothing_listens_and_nothing_is_drawn()
    set_hint(HINT_VIDEO_DRIVER, "dummy")

    val dir = make_temp_dir("syslui-ctl-").unwrap()
    val q: &Quiet = Quiet(0, false, true, join(dir, "app.sock"), join(dir, "frame.png"))
    val n = signal(0)
    val tree = save_button(n)
    val on_tree: &Fn() -> &View = () -> tree
    val on_ground: &Fn() -> u32 = () -> 0x000000u32
    val on_frame: &Fn(real) -> unit = dt -> quiet_frame(q)

    run(app("quiet", on_tree, on_ground, width = 240, height = 160, on_frame = on_frame)).unwrap()

    assert(q.had_window, "the window is handed out without a socket too")
    assert(!q.listening)

    val image = png.decode(sysl.fs.read_bytes(q.saved).unwrap().view()).unwrap()

    for y in 0..<image.height
        for x in 0..<image.width
            val p = image.at(x, y)

            assert((p.r, p.g, p.b) != MAGENTA, f"no pointer mark at $x,$y")

    remove_dir_all(dir).unwrap()
end without_a_socket_nothing_listens_and_nothing_is_drawn

// ## The application's own routes

// What an application adds: `GET /app/state`, and a `/snapshot` of its own only when asked for one.
private app_routes(req: Request) -> Routed
    if req.path == "/app/state" then return Respond(sh.sysl.sdl3.control.json(200, "{\"mine\":true}\n"))
    if req.path == "/snapshot" && req.query == "mine" then return Respond(sh.sysl.sdl3.control.json(200, "{}\n"))

    Pass
end app_routes

private plain_tree() -> &View = text("plain")

private plain_ground() -> u32 = 0

// An application that answers every optional part with its default.
private plain_app() -> &App
    val on_tree: &Fn() -> &View = () -> plain_tree()
    val on_ground: &Fn() -> u32 = () -> plain_ground()

    app("plain", on_tree, on_ground)
end plain_app

@test
private an_application_route_answers_before_the_built_in_ones()
    val s = shown_of(save_button(signal(0)), 1.0)
    val own: &Fn(Request) -> Routed = req -> app_routes(req)
    val r = refused(route_of(s, own, request_of("GET", "/app/state")))

    assert_eq(r.status, 200)
    assert_eq(body_of(r), "{\"mine\":true}\n")

    val shadow = refused(route_of(s, own, Request("GET", "/snapshot", "mine", buf(), buf())))

    assert_eq(body_of(shadow), "{}\n", "asked first, so it may answer a built-in path itself")
end an_application_route_answers_before_the_built_in_ones

@test
private a_pass_from_the_application_falls_through_to_the_built_in_routes()
    val s = shown_of(save_button(signal(0)), 1.0)
    val own: &Fn(Request) -> Routed = req -> app_routes(req)
    val snap = refused(route_of(s, own, request_of("GET", "/snapshot")))

    assert_eq(snap.status, 200)
    assert(body_of(snap).contains("\"save\""), "the toolkit's snapshot")
    assert_eq(forwarded(route_of(s, own, click_request("ref=save"))).param("x"), Some("100.5"), "a click by reference")
    assert(matches_pass(route_of(s, own, request_of("GET", "/state"))), "and sdl3's own routes after that")
end a_pass_from_the_application_falls_through_to_the_built_in_routes

@test
private an_application_that_names_no_routes_passes_everything_on()
    val s = shown_of(save_button(signal(0)), 1.0)
    val none = plain_app().routes

    assert(matches_pass(none(request_of("GET", "/app/state"))), "the default answers Pass")
    assert(matches_pass(route_of(s, none, request_of("GET", "/app/state"))), "so sdl3 answers 404 itself")
    assert_eq(refused(route_of(s, none, request_of("GET", "/snapshot"))).status, 200)
end an_application_that_names_no_routes_passes_everything_on

// ## A hidden window

@test
private the_hidden_option_is_sdls_hidden_window_and_off_by_default()
    assert_eq(shown_flags(true), WINDOW_HIDDEN)
    assert_eq(shown_flags(false), 0u64)
    assert(!plain_app().hidden, "a window is shown unless asked")
end the_hidden_option_is_sdls_hidden_window_and_off_by_default

// A run that GETs each target in turn and keeps what came back.
private struct Fetches
    at: string
    targets: Buf[string]
    next: usize
    client: Option[&Client]
    statuses: Buf[int]
    bodies: Buf[string]
    middle: (u8, u8, u8)
    frames: int
    started: u64

private fetch_frame(s: &Fetches)
    s.frames += 1

    if s.frames == 1 then s.started = ticks_ns()
    if ticks_ns() - s.started > 10000000000u64 then stop()

    s.client match
        Some(cl) ->
            drain(cl)

            if !cl.over then return

            s.statuses.push(status_of(cl))

            if s.targets.at(s.next - 1) == "/shot"
                val image = png.decode(body_bytes(cl)).unwrap()
                val p = image.at(image.width / 2, image.height - 2)

                s.middle = (p.r, p.g, p.b)
                s.bodies.push("")
            else
                s.bodies.push(from_utf8_lossy(body_bytes(cl)))

            s.client = None
        None -> ()

    if s.next >= s.targets.len()
        stop()
        return

    s.client = Some(send(s.at, "GET", s.targets.at(s.next)))
    s.next += 1
end fetch_frame

// A hidden window, driven over its socket: the application's route answers, the built-ins still do, the
// window says it is hidden, and `/shot` reads back the frame it painted all the same.
@test
private a_hidden_application_answers_its_own_routes_and_its_shot()
    set_hint(HINT_VIDEO_DRIVER, "dummy")

    val dir = make_temp_dir("syslui-ctl-").unwrap()
    val at = join(dir, "app.sock")
    val targets: Buf[string] = buf()

    for t in ["/app/state", "/snapshot", "/state", "/shot", "/nowhere"]
        targets.push(t)

    val s: &Fetches = Fetches(at, targets, 0, None, buf(), buf(), CLEARED, 0, 0)
    val tree = save_button(signal(0))
    val on_tree: &Fn() -> &View = () -> tree
    val on_ground: &Fn() -> u32 = () -> 0x336699u32
    val on_frame: &Fn(real) -> unit = dt -> fetch_frame(s)
    val own: &Fn(Request) -> Routed = req -> app_routes(req)

    run(app("hidden", on_tree, on_ground, width = 240, height = 160, on_frame = on_frame, control = at,
            routes = own, hidden = true)).unwrap()

    assert_eq(s.statuses.len(), 5)
    assert_eq(s.statuses.at(0), 200, "the application's route")
    assert_eq(s.bodies.at(0), "{\"mine\":true}\n")
    assert_eq(s.statuses.at(1), 200, "the toolkit's snapshot")
    assert(s.bodies.at(1).contains("\"save\""), s.bodies.at(1))
    assert_eq(s.statuses.at(2), 200, "sdl3's state")
    assert(s.bodies.at(2).contains("\"hidden\":true"), s.bodies.at(2))
    assert_eq(s.statuses.at(3), 200, "the shot")
    assert_eq(s.middle, (0x33u8, 0x66u8, 0x99u8), "the shot holds the painted ground")
    assert_eq(s.statuses.at(4), 404, "an unknown path is still sdl3's 404")
    remove_dir_all(dir).unwrap()
end a_hidden_application_answers_its_own_routes_and_its_shot
