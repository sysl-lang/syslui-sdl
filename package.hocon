// syslUI's SDL3 driver — the window, the frame loop and the events, for a desktop and for a phone.
//
// **It is a separate package rather than part of syslUI, and the reason is the link line.** A link
// directive is never pruned, so putting SDL3 in the toolkit's own manifest would put `-lSDL3` on
// every consumer's link line — including a panel driver on a microcontroller that has no window
// system at all. That is the same argument that makes SDL3 four packages in this org rather than
// one, and it is why `sh.sysl.ui` names nothing but `sysl.*` and PlutoVG.
//
//     dependencies {
//       syslui-sdl { git = "github.com/sysl-lang/syslui-sdl", version = "0.2.0" }
//     }
//
// A program naming this one gets syslUI with it, so it names only this.
//
// **0.2.0 removes `set_insets`, which is why it is not 0.1.2.** The system bars used to be pushed
// into this module by the application's own JNI entry point, because the symbol JNI looks up is
// mangled from the *application's* package and so the `@export` could not live in a library.
// `sysl-lang/skitter` fixes the activity's class, which fixes the symbol, which makes the bridge a
// library's — so this driver reads the bars itself and an application forwards nothing. A program on
// 0.1.1 that called `set_insets` deletes that call and its JNI export together.
package {
  name    = "syslui-sdl"
  version = "0.2.0"
}

// **Skitter is here for the parts of a phone SDL does not answer**, and it brings SDL3 with it. What
// this driver takes from it is the system bars and the orientation pair — both of which were written
// out here until 0.2.0, and neither of which is a thing a driver should be deciding on its own.
dependencies {
  syslui  { git = "github.com/sysl-lang/syslui",  version = "0.1.1" }
  skitter { git = "github.com/sysl-lang/skitter", version = "0.1.0" }
  sdl3    { git = "github.com/sysl-lang/sdl3",    version = "0.3.1" }
  plutovg { git = "github.com/sysl-lang/plutovg", version = "0.2.1" }
}

// `os` is the clock the frame loop paces on; `posix` is the font file PlutoVG rasterizes from.
requires {
  os    = true
  posix = true
  heap  = true
}
